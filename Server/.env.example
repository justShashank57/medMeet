NODE_ENV=development
PORT=5500

# MongoDB connection string. Use a strong, unique username/password pair,
# never reuse one as the other, and restrict network access in Atlas.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin of the deployed frontend, used for CORS.
CLIENT_URL=http://localhost:3000

# Shared secret required in the x-admin-key header to create/delete doctors.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Optional: SMTP settings for appointment email notifications.
# If unset, emails are skipped (booking/confirmation still succeeds).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Med-Meet <no-reply@med-meet.local>

# Optional: Sentry DSN for error tracking. If unset, errors are only logged locally.
SENTRY_DSN=
